---
import "../styles/site.css";

const commands = [
  ['detour start "Fix deploy"', "root task"],
  ['detour into "Refresh kubeconfig"', "nested detour"],
  ['detour pothole "SSO token expired"', "mark friction"],
  ['detour into "Debug SSO role"', "one more turn"],
  ['detour done "Role expired"', "pop back"],
];

const features = [
  {
    title: "Stack-first state",
    body: "The active chain lives in JSON, so humans and agents can both ask where the work actually is.",
  },
  {
    title: "LogSeq-safe notes",
    body: "Write to plain Markdown or append under an existing LogSeq journal block with configurable date filenames.",
  },
  {
    title: "Block-like commands",
    body: "Idempotent keys, structured events, and potholes let automations trace messy work without parsing prose.",
  },
];

const stackItems = ["Fix deploy", "Refresh kubeconfig", "SSO token expired", "Debug SSO role"];

const agentCommands =
  'detour event \'{"type":"into","title":"Debug SSO role","key":"debug-sso-role"}\' --json\n' +
  'detour event \'{"type":"pothole","message":"VPN dropped"}\' --json\n' +
  "detour status --json";

const installCommand =
  "pipx install git+https://github.com/Midtown-Technology-Group/detour.git@v0.1.3";

const logseqConfig =
  'notes_dir = "~/OneDrive - Midtown Technology Group LLC/Knowledge/daily"\n' +
  'section_heading = "Detours"\n' +
  'time_format = "%H:%M"\n' +
  'note_filename_format = "%Y_%m_%d"\n' +
  'note_style = "logseq"';

const maturityItems = [
  "AGPL-3.0-only license",
  "CI, release, audit, and coverage gates",
  "Contributing, support, security, and conduct docs",
  "GitHub issue templates",
];

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="detour tracks the work you did to get back to the work you meant to do."
    />
    <title>detour - track the work before the work</title>
  </head>
  <body>
    <main>
      <section class="hero app-shell" aria-labelledby="hero-title">
        <div class="road-grid" aria-hidden="true"></div>
        <div class="hero-inner">
          <nav class="topbar" aria-label="Project links">
            <a class="brand" href={basePath} aria-label="detour home">
              <span class="brand-mark">D</span>
              <span>detour</span>
            </a>
            <a class="repo-link" href="https://github.com/Midtown-Technology-Group/detour">
              GitHub
            </a>
          </nav>

          <div class="workspace">
            <aside class="side-rail" aria-label="Detour stack preview">
              <div class="sign-panel" aria-hidden="true">
                <span>DETOUR</span>
              </div>
              <div class="stack-card">
                <p class="panel-label">active chain</p>
                <ol>
                  {stackItems.map((item, index) => (
                    <li>
                      <span>{index + 1}</span>
                      <strong>{item}</strong>
                    </li>
                  ))}
                </ol>
              </div>
            </aside>

            <div class="hero-copy">
              <p class="eyebrow">v0.1.3 CLI for task chains</p>
              <h1 id="hero-title">Track the work before the work.</h1>
              <p class="lede">
                <code>detour</code> records the side quests you had to handle before getting back to
                the thing you actually meant to do.
              </p>
              <div class="hero-actions">
                <a class="primary-action" href="#install">Install</a>
                <a class="secondary-action" href="#agent-mode">Agent mode</a>
              </div>
            </div>

            <div class="terminal" aria-label="Example detour session">
              <div class="terminal-top">
                <span></span>
                <span></span>
                <span></span>
                <strong>detour trace</strong>
              </div>
              <ol>
                {commands.map(([command, note]) => (
                  <li>
                    <span class="prompt">detour</span>
                    <code>{command}</code>
                    <small>{note}</small>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section class="band">
        <div class="section-inner feature-grid">
          {features.map((feature) => (
            <article class="feature">
              <h2>{feature.title}</h2>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section-inner split" id="agent-mode">
        <div>
          <p class="eyebrow">Agent-friendly</p>
          <h2>Deterministic traces for messy work.</h2>
          <p>
            Agents can ask for the active chain, push idempotent detours, and write
            structured events without scraping terminal copy.
          </p>
        </div>
        <pre><code>{agentCommands}</code></pre>
      </section>

      <section class="section-inner split">
        <div>
          <p class="eyebrow">LogSeq-ready</p>
          <h2>Land detours inside the journal you already use.</h2>
          <p>
            Detour can keep its plain Markdown output, or switch into a LogSeq-friendly mode
            that appends beneath a <code>- Detours</code> block in the existing daily page.
          </p>
        </div>
        <pre><code>{logseqConfig}</code></pre>
      </section>

      <section class="band maturity-band">
        <div class="section-inner maturity-grid">
          <div>
            <p class="eyebrow">Project maturity</p>
            <h2>Small tool, real guardrails.</h2>
          </div>
          <ul>
            {maturityItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="install" id="install">
        <div class="section-inner install-inner">
          <div>
            <p class="eyebrow">Install</p>
            <h2>Drop it into your dev-toy belt.</h2>
          </div>
          <pre><code>{installCommand}</code></pre>
        </div>
      </section>
    </main>
  </body>
</html>
